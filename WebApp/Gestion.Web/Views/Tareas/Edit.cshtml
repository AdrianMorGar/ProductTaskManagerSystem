@model Gestion.Web.Models.Tarea

<h1>Editar Tarea</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ProductoId" />

    <div class="form-group">
        <label asp-for="Descripcion"></label>
        <input asp-for="Descripcion" class="form-control" />
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="form-group form-check mt-3">
        <input asp-for="EstaCompletada" class="form-check-input" />
        <label class="form-check-label" asp-for="EstaCompletada"></label>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Actualizar Tarea</button>
    <a asp-action="Index" asp-route-productoId="@Model.ProductoId" class="btn btn-secondary">Cancelar</a>
</form>
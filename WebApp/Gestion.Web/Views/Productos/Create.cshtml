@model Gestion.Web.Models.Producto

<h1>Crear Producto</h1>
<form asp-action="Create">
    <div class="form-group">
        <label>Nombre (Obligatorio)</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Precio (Mayor a 0)</label>
        <input asp-for="Precio" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Stock (No negativo)</label>
        <input asp-for="Stock" class="form-control" type="number" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Categoría</label>
        <input asp-for="Categoria" class="form-control" />
    </div>
    <br />
    <button type="submit" class="btn btn-success">Guardar Producto</button>
    <a asp-action="Index">Volver a la lista</a>
</form>
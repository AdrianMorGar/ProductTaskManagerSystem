<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gestion.Desktop.MainPage"
             Title="Gestión de Productos"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="15">

        <Frame Grid.Row="0" BorderColor="#D1D1D1" Padding="15" BackgroundColor="White" HasShadow="True">
            <VerticalStackLayout Spacing="12">
                <Label Text="REGISTRAR NUEVO PRODUCTO" FontSize="14" FontAttributes="Bold" TextColor="#444"/>

                <HorizontalStackLayout Spacing="10">
                    <Entry x:Name="EntNombre" Placeholder="Nombre" WidthRequest="180" BackgroundColor="#FAFAFA" TextColor="Black" PlaceholderColor="Gray"/>
                    <Entry x:Name="EntPrecio" Placeholder="Precio €" Keyboard="Numeric" WidthRequest="90" BackgroundColor="#FAFAFA" TextColor="Black" PlaceholderColor="Gray"/>
                    <Entry x:Name="EntStock" Placeholder="Stock" Keyboard="Numeric" WidthRequest="70" BackgroundColor="#FAFAFA" TextColor="Black" PlaceholderColor="Gray"/>
                    <Entry x:Name="EntCategoria" Placeholder="Categoría" WidthRequest="120" BackgroundColor="#FAFAFA" TextColor="Black" PlaceholderColor="Gray"/>
                </HorizontalStackLayout>

                <Button Text="CREAR PRODUCTO" Clicked="OnCrearProductoClicked" 
                        BackgroundColor="#28A745" TextColor="White" FontAttributes="Bold" HeightRequest="45"/>
            </VerticalStackLayout>
        </Frame>

        <Button Grid.Row="1" x:Name="BtnRefrescar" Text="RECARGAR LISTADO" Clicked="OnRefreshClicked" 
                BackgroundColor="#6C757D" TextColor="White" HeightRequest="40"/>

        <CollectionView Grid.Row="2" x:Name="ListaProductos" SelectionMode="Single" SelectionChanged="OnProductoSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="15" BorderColor="#E0E0E0" BackgroundColor="White" HasShadow="False" CornerRadius="8">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">

                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="18" TextColor="#212121"/>
                                <Label Text="{Binding Categoria, StringFormat='Categoría: {0}'}" FontSize="13" TextColor="#666"/>

                                <HorizontalStackLayout Spacing="20" Margin="0,5,0,0">
                                    <Label Text="{Binding Precio, StringFormat='{0:F2} €'}" FontAttributes="Bold" TextColor="#28A745" FontSize="16"/>
                                    <Label Text="{Binding Stock, StringFormat='Stock: {0} uds'}" TextColor="#0056B3" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Text="✎" Clicked="OnEditarProductoClicked" 
                                    BackgroundColor="#FFC107" TextColor="Black" HeightRequest="45" WidthRequest="45" CornerRadius="22"/>
                            <Button Grid.Column="2" Text="🗑" Clicked="OnEliminarProductoClicked" 
                                    BackgroundColor="#DC3545" TextColor="White" HeightRequest="45" WidthRequest="45" CornerRadius="22"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
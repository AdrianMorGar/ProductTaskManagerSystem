<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gestion.Desktop.DetalleProductoPage"
             Title="Tareas del Producto"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Button Text="← VOLVER AL LISTADO" Clicked="OnVolverClicked" 
                BackgroundColor="#6C757D" TextColor="White" HorizontalOptions="Start" HeightRequest="35"/>

        <Label x:Name="LblProducto" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#212121" Margin="0,10"/>

        <Frame BorderColor="#28A745" Padding="8" BackgroundColor="White" HasShadow="False">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Entry x:Name="EntNuevaTarea" Placeholder="¿Qué hay que hacer?" TextColor="Black" Grid.Column="0" BackgroundColor="Transparent"/>
                <Button Text="AÑADIR" Clicked="OnAddTareaClicked" BackgroundColor="#28A745" TextColor="White" Grid.Column="1" FontAttributes="Bold"/>
            </Grid>
        </Frame>

        <CollectionView x:Name="ListaTareas" HeightRequest="400">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,3" Padding="12" BorderColor="#E0E0E0" BackgroundColor="White">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12">
                            <CheckBox Grid.Column="0" IsChecked="{Binding EstaCompletada}" CheckedChanged="OnTareaCheckedChanged" Color="#28A745"/>

                            <Label Grid.Column="1" Text="{Binding Descripcion}" TextColor="#333" VerticalOptions="Center" FontSize="15"/>

                            <Button Grid.Column="2" Text="✎" Clicked="OnEditTareaClicked" 
                                    BackgroundColor="#FFC107" TextColor="Black" WidthRequest="40" HeightRequest="40" CornerRadius="20"/>

                            <Button Grid.Column="3" Text="🗑" Clicked="OnDeleteTareaClicked" 
                                    BackgroundColor="#DC3545" TextColor="White" WidthRequest="40" HeightRequest="40" CornerRadius="20"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>